DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
# Google OAuth: create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://hejoric.com/api/auth/callback/google
# (and http://localhost:3000/api/auth/callback/google for local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only this email is allowed to sign in / write.
ADMIN_EMAIL=hejoric@gmail.com

# Powers the Code heatmap: classic PAT with `read:user`, or a fine-grained
# token with read access to profile data. Without it the Code graph is omitted
# instead of rendered empty.
GITHUB_TOKEN=

# Bearer token so an Android home-screen shortcut can log activity without a
# Google session: POST /api/activity with `Authorization: Bearer <token>`.
# Generate with `openssl rand -hex 32`. Tokens under 24 chars are ignored.
# Scope is narrow on purpose: this token cannot publish projects or posts, and
# it still cannot write `code`. Leave unset to disable phone logging entirely.
# Setup guide: docs/phone-logging.md
ACTIVITY_TOKEN=
