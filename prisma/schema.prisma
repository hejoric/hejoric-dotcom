generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// Connection URLs live in prisma.config.ts (CLI) and lib/prisma.ts (runtime).
datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  role      String   @default("user")
  createdAt DateTime @default(now())
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  techStack   String[]
  githubUrl   String?
  liveUrl     String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String?
  tags        String[]
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

// Hand-logged activity for the non-code tracker categories (music, language,
// fitness, reading). Code is never stored here: it is fetched live from the
// GitHub contribution API in lib/github.ts, so there is one source of truth.
//
// `note` is private unless `isPublic` is true: only public notes are ever
// selected by the page loaders in lib/activity.ts.
model ActivityLog {
  id        String   @id @default(cuid())
  date      DateTime
  category  String
  count     Int      @default(1)
  note      String?
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([date, category])
}
